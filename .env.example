# Copy to .env.local; edit AI_BASE_URL, AI_MODEL, AI_API_KEY and AI_FREE_ONLY.
# Setup and compatibility requirements: README.md > Getting started.
# OpenAI-compatible Chat Completions base URL (without /chat/completions).
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=dots-studio/dots-3-note-preview:free
AI_API_KEY=
# true: OpenRouter free models only. false: allow the model you select, including paid models.
AI_FREE_ONLY=true
# The model AND its serving endpoint must support images and strict JSON-schema output.
# Use an explicit vendor/model:free ID; automatic routers such as openrouter/free are rejected.
# Free availability/quotas change. A stronger model may help; the key itself does not improve quality.
# Restart the relay after edits. Never put API keys in the app or Git.
DEV_ACCESS_TOKEN=
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
